# AnyDB Internal API Configuration
ANYDB_API_URL=https://app.anydb.com/api
ANYDB_DEFAULT_API_KEY=your-anydb-api-key
ANYDB_DEFAULT_USER_EMAIL=email-associated-with-api-key

# HTTP transport (npm run start:http)
# Port is separate from REST_API_PORT so both servers can run side by side.
MCP_HTTP_PORT=3001
# Bind loopback by default. Use 0.0.0.0 only behind a TLS-terminating proxy.
MCP_HTTP_HOST=127.0.0.1
# Comma-separated browser origins. Leave unset to emit no CORS headers,
# which is correct for non-browser MCP clients.
MCP_ALLOWED_ORIGINS=

# OAuth 2.1 bearer auth on the HTTP transport (see docs/token-contract.md)
# Canonical resource identifier; the audience access tokens must carry.
MCP_RESOURCE_URI=https://mcp.anydb.com
# Authorization server that issues those tokens.
MCP_OAUTH_ISSUER=https://app.anydb.com
# Defaults to <issuer>/.well-known/jwks.json when unset.
MCP_OAUTH_JWKS_URI=
# Set false to run API-key-only.
MCP_OAUTH_ENABLED=true

# Optional fixture for the headless presigned-download integration test
ANYDB_TEST_TEAM_ID=
ANYDB_TEST_DATABASE_ID=
ANYDB_TEST_FILE_RECORD_ID=
ANYDB_TEST_FILE_CELL_POS=A1
ANYDB_TEST_FILE_SHA256=
