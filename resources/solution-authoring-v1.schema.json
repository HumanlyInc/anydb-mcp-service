{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anydb://schemas/solution-authoring/v1",
  "title": "AnyDB Solution Authoring Contract v1",
  "description": "Semantic schemas for AnyDB solution-authoring mutation tools.",
  "type": "object",
  "$defs": {
    "objectId": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{24}$"
    },
    "createWorkspaceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamid",
        "name",
        "clientRequestId"
      ],
      "properties": {
        "teamid": {
          "$ref": "#/$defs/objectId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Name of the new empty workspace."
        },
        "clientRequestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "colspan",
        "rowspan"
      ],
      "properties": {
        "position": {
          "type": "string",
          "pattern": "^[A-Z]+[1-9][0-9]*$"
        },
        "colspan": {
          "type": "integer",
          "minimum": 1
        },
        "rowspan": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "valueType",
        "format",
        "layout"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "headingLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Displayed heading text. Required only when format is heading; the server stores it in the HEADING_LABEL cell prop rather than the cell value."
        },
        "valueType": {
          "enum": [
            "string",
            "number",
            "boolean",
            "array",
            "void",
            "file",
            "object",
            "ref",
            "user"
          ]
        },
        "format": {
          "enum": [
            "general",
            "number",
            "currency",
            "percentage",
            "date",
            "datetime",
            "time",
            "ref",
            "signature",
            "file",
            "checkbox",
            "user",
            "users",
            "select",
            "multi-select",
            "rich-text",
            "attachments",
            "comments",
            "ai",
            "barcode",
            "qrcode",
            "chart",
            "report",
            "lookup",
            "button",
            "timeline",
            "dynamic",
            "heading"
          ]
        },
        "formula": {
          "type": "string",
          "minLength": 1
        },
        "targetType": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 120 },
            {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "value": { "type": "string", "minLength": 1, "maxLength": 120 },
                "expr": { "type": "string", "minLength": 1 }
              }
            }
          ],
          "description": "The type a ref or attachments field points at. A string names a fixed target. To vary the target per record - a polymorphic reference, the same thing the type designer offers as a computed property - pass an object with expr, and optionally value for the target it should show until the expression first evaluates. Example: {\"value\": \"Employer\", \"expr\": \"IF({{Payer Kind}}=='Insurer', 'Insurer', 'Employer')\"}. Do not set ATTACHMENTS_TEMPLATE_NAME through props; this field owns it."
        },
        "lookup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fromField",
            "targetField"
          ],
          "properties": {
            "fromField": {
              "type": "string",
              "minLength": 1,
              "description": "Key of the local ref field through which the target record is selected."
            },
            "targetField": {
              "type": "string",
              "minLength": 1,
              "description": "Key of the field to read from the referenced record."
            },
            "mode": {
              "enum": [
                "snapshot",
                "live"
              ],
              "default": "snapshot",
              "description": "Use snapshot to copy the target value when the ref is selected without later target-change ripple; use live when target changes must update referencing records."
            }
          }
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "locked": {
          "type": "boolean",
          "default": false
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "props": {
          "type": "object",
          "description": "Raw cell properties, for presentation and behaviour the named fields above do not cover. Property names are the AnyDB cell-property constants, e.g. BACKGROUND_COLOR, TEXT_BOLD, TEXT_ALIGN, CELL_HIDDEN, FORM_HIDDEN, CELL_DISPLAY_AS, CELL_ERROR, DATE_DISPLAY, CHECKBOX_DISPLAY, X_SIZE. Do not set CELL_DESCRIPTION, HEADING_LABEL, CELL_LOCKED, CELL_REQUIRED, SELECT_OPTIONS, or ATTACHMENTS_TEMPLATE_NAME here - use the description, headingLabel, locked, required, options, and targetType fields instead; sending them here is rejected. AI_PROMPT is how an ai-format cell gets its prompt, and BUTTON_ACTION_TYPE/BUTTON_ACTION_VALUE wire a button-format cell to an automation. These cannot be set: SCRIPT_SOURCE, ATTACHMENTS_TEMPLATE_ID, ATTACHMENTS_PARENT, VALUE_OVERRIDE, CELL_HIDDEN_ACCESS, CELL_LOCKED_ACCESS. On update, sending props replaces the whole map for that field; omitting it preserves what is already there.",
          "additionalProperties": {
            "$ref": "#/$defs/cellProp"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "heading"
              }
            }
          },
          "then": {
            "required": [
              "headingLabel"
            ]
          },
          "else": {
            "not": {
              "required": [
                "headingLabel"
              ]
            }
          }
        }
      ]
    },
    "badge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "formula"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "formula": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "childPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowOnly",
        "autoCreate"
      ],
      "properties": {
        "allowOnly": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "autoCreate": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "typeName",
              "minimum"
            ],
            "properties": {
              "typeName": {
                "type": "string",
                "minLength": 1
              },
              "minimum": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "viewFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "field",
        "operator",
        "value"
      ],
      "properties": {
        "source": {
          "enum": [
            "cell",
            "meta",
            "badge"
          ]
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "operator": {
          "enum": [
            "eq",
            "neq",
            "gt",
            "lt",
            "gte",
            "lte",
            "like",
            "contains",
            "startswith",
            "endswith",
            "includes",
            "notincludes"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ],
          "description": "Native JSON filter value. Numbers and booleans must not be stringified; the server does not coerce based on fieldType."
        },
        "fieldType": {
          "enum": [
            "string",
            "number",
            "boolean",
            "date",
            "array"
          ],
          "description": "Optional stored comparison-type hint. Match the target field's actual type; it does not coerce value and is not required."
        }
      }
    },
    "viewTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typeName"
      ],
      "properties": {
        "typeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Stable workspace type name whose records the View can display. The name applies across revisions of that type; do not use a template ID."
        },
        "filters": {
          "type": "array",
          "description": "Filters applied only to records of this target type. Omit or use an empty array to include all records of the type within the View scope.",
          "items": {
            "$ref": "#/$defs/viewFilter"
          }
        }
      }
    },
    "viewDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scope",
        "targets"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scope": {
          "enum": [
            "workspace",
            "children"
          ],
          "description": "workspace attaches the View to the database root for workspace-level type filtering; children attaches it to parentRecordId and filters matching direct children of that record."
        },
        "parentRecordId": {
          "$ref": "#/$defs/objectId",
          "description": "Required only for children scope. The View lists matching direct children attached to this parent record."
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/viewTarget"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "children"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "required": [
              "parentRecordId"
            ]
          },
          "else": {
            "not": {
              "required": [
                "parentRecordId"
              ]
            }
          }
        }
      ]
    },
    "createViewInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamid",
        "adbid",
        "clientRequestId",
        "view"
      ],
      "properties": {
        "teamid": {
          "$ref": "#/$defs/objectId"
        },
        "adbid": {
          "$ref": "#/$defs/objectId"
        },
        "clientRequestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Required idempotency key for this create request. Reuse only when retrying the identical request."
        },
        "validateOnly": {
          "type": "boolean",
          "default": false
        },
        "view": {
          "$ref": "#/$defs/viewDefinition"
        }
      }
    },
    "updateViewInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamid",
        "adbid",
        "viewId",
        "clientRequestId",
        "changes"
      ],
      "properties": {
        "teamid": {
          "$ref": "#/$defs/objectId"
        },
        "adbid": {
          "$ref": "#/$defs/objectId"
        },
        "viewId": {
          "$ref": "#/$defs/objectId"
        },
        "clientRequestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "validateOnly": {
          "type": "boolean",
          "default": false
        },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "description": "Complete replacement target and filter set. Omit to preserve existing View criteria.",
              "items": {
                "$ref": "#/$defs/viewTarget"
              }
            }
          }
        }
      }
    },
    "listViewsInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamid",
        "adbid"
      ],
      "properties": {
        "teamid": {
          "$ref": "#/$defs/objectId"
        },
        "adbid": {
          "$ref": "#/$defs/objectId"
        }
      }
    },
    "getViewInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamid",
        "adbid",
        "viewId"
      ],
      "properties": {
        "teamid": {
          "$ref": "#/$defs/objectId"
        },
        "adbid": {
          "$ref": "#/$defs/objectId"
        },
        "viewId": {
          "$ref": "#/$defs/objectId"
        }
      }
    },
    "deleteViewInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamid",
        "adbid",
        "viewId",
        "clientRequestId"
      ],
      "properties": {
        "teamid": {
          "$ref": "#/$defs/objectId"
        },
        "adbid": {
          "$ref": "#/$defs/objectId"
        },
        "viewId": {
          "$ref": "#/$defs/objectId"
        },
        "clientRequestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "shareTarget": {
      "description": "Share target. For a record use {\"kind\":\"record\",\"recordId\":\"<adoid>\"}; for a form use {\"kind\":\"form\",\"templateName\":\"<stable type name>\"} with optional parentRecordId.",
      "oneOf": [
        {
          "title": "Record target",
          "description": "Share an existing record: {\"kind\":\"record\",\"recordId\":\"<adoid>\"}.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "recordId"
          ],
          "properties": {
            "kind": {
              "const": "record"
            },
            "recordId": {
              "$ref": "#/$defs/objectId"
            }
          }
        },
        {
          "title": "Form target",
          "description": "Share a form for a stable workspace type: {\"kind\":\"form\",\"templateName\":\"Safety Report\"}.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "templateName"
          ],
          "properties": {
            "kind": {
              "const": "form"
            },
            "templateName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Stable workspace template name used by the form."
            },
            "parentRecordId": {
              "$ref": "#/$defs/objectId",
              "description": "Record under which form submissions are created. When omitted, the server creates a Folder under the database root and returns that Folder's ID as parentRecordId."
            }
          }
        }
      ]
    },
    "shareRecipients": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "emails": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "email"
          }
        },
        "groupNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Stable team group name returned by anydb_list_team_groups."
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "emails"
          ]
        },
        {
          "required": [
            "groupNames"
          ]
        }
      ]
    },
    "createShareInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamid",
        "adbid",
        "clientRequestId",
        "share"
      ],
      "properties": {
        "teamid": {
          "$ref": "#/$defs/objectId"
        },
        "adbid": {
          "$ref": "#/$defs/objectId"
        },
        "clientRequestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "validateOnly": {
          "type": "boolean",
          "default": false
        },
        "share": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "privacy",
            "target"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "privacy": {
              "enum": [
                "public",
                "private"
              ]
            },
            "target": {
              "$ref": "#/$defs/shareTarget"
            },
            "recipients": {
              "$ref": "#/$defs/shareRecipients"
            },
            "role": {
              "enum": [
                "viewer",
                "editor"
              ],
              "description": "Optional for record shares; the server uses viewer when omitted. Must be omitted for form shares."
            },
            "withAttachments": {
              "type": "boolean",
              "description": "Optional for record shares; the server uses false when omitted. Must be omitted for form shares."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "privacy": {
                    "const": "private"
                  }
                },
                "required": [
                  "privacy"
                ]
              },
              "then": {
                "required": [
                  "recipients"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "recipients"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "target": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "form"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  }
                },
                "required": [
                  "target"
                ]
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "role"
                      ]
                    },
                    {
                      "required": [
                        "withAttachments"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "listTeamGroupsInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamid"
      ],
      "properties": {
        "teamid": {
          "$ref": "#/$defs/objectId"
        }
      }
    },
    "listSharesInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamid",
        "adbid"
      ],
      "properties": {
        "teamid": {
          "$ref": "#/$defs/objectId"
        },
        "adbid": {
          "$ref": "#/$defs/objectId"
        }
      }
    },
    "getShareInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamid",
        "adbid",
        "shareId",
        "kind"
      ],
      "properties": {
        "teamid": {
          "$ref": "#/$defs/objectId"
        },
        "adbid": {
          "$ref": "#/$defs/objectId"
        },
        "shareId": {
          "$ref": "#/$defs/objectId"
        },
        "kind": {
          "enum": [
            "record",
            "form"
          ],
          "description": "Share facet to retrieve; one internal share may contain both facets."
        }
      }
    },
    "revokeShareInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamid",
        "adbid",
        "shareId",
        "kind",
        "clientRequestId"
      ],
      "properties": {
        "teamid": {
          "$ref": "#/$defs/objectId"
        },
        "adbid": {
          "$ref": "#/$defs/objectId"
        },
        "shareId": {
          "$ref": "#/$defs/objectId"
        },
        "kind": {
          "enum": [
            "record",
            "form"
          ],
          "description": "Share facet to revoke without affecting a different facet on the same internal share."
        },
        "clientRequestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "typeDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fields"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "icon": {
          "type": "string",
          "description": "Lucide icon and colors in the canonical format icon::<lucide-icon-name>::<foreground-hex>::<background-hex>, for example icon::clipboard-check::#1565C0::#FFFFFF. The background hex is not decorative metadata: it is painted as the type card's background in the workspace type list, in both the grid and hierarchy views, and the card border is derived from it, so it is how a type is color-coded or pastel-tinted. Use #FAFAFA as the background to leave the card neutral; that exact value is the no-tint sentinel and renders as a plain white card. This is unrelated to the per-field BACKGROUND_COLOR property, which tints a single cell inside a record and has no effect on the card."
        },
        "titleFormula": {
          "type": "string",
          "minLength": 1,
          "description": "Optional record-title formula. Records of the type are named by evaluating it, and the name is recomputed when a field it reads changes. Must be a formula expression in the same language as a cell formula, not a template string. CONCAT is the only supported way to join text: CONCAT('Meeting: ', {{Subject}}) works, while {{Subject}} ({{Status}}), {{A}} & {{B}} and {{A}} + {{B}} do not. A template string, an unknown field key, an unknown function, or a syntax error is rejected silently \u2014 the record keeps its existing name and no error is returned \u2014 so confirm a new formula by reading one record's meta.name back."
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "badges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/badge"
          }
        }
      }
    },
    "createTypeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamid",
        "adbid",
        "clientRequestId",
        "mode"
      ],
      "properties": {
        "teamid": {
          "$ref": "#/$defs/objectId"
        },
        "adbid": {
          "$ref": "#/$defs/objectId"
        },
        "clientRequestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "validateOnly": {
          "type": "boolean",
          "default": false
        },
        "mode": {
          "enum": [
            "define",
            "import_builtin"
          ]
        },
        "type": {
          "$ref": "#/$defs/typeDefinition"
        },
        "builtInTemplateName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "define"
              }
            }
          },
          "then": {
            "required": [
              "type"
            ]
          },
          "else": {
            "required": [
              "builtInTemplateName"
            ]
          }
        }
      ]
    },
    "fieldUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "newKey": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "headingLabel": {
          "$ref": "#/$defs/field/properties/headingLabel"
        },
        "valueType": {
          "$ref": "#/$defs/field/properties/valueType"
        },
        "format": {
          "$ref": "#/$defs/field/properties/format"
        },
        "formula": {
          "type": "string"
        },
        "targetType": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 120 },
            {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "value": { "type": "string", "minLength": 1, "maxLength": 120 },
                "expr": { "type": "string", "minLength": 1 }
              }
            }
          ],
          "description": "The type a ref or attachments field points at. A string names a fixed target. To vary the target per record - a polymorphic reference, the same thing the type designer offers as a computed property - pass an object with expr, and optionally value for the target it should show until the expression first evaluates. Example: {\"value\": \"Employer\", \"expr\": \"IF({{Payer Kind}}=='Insurer', 'Insurer', 'Employer')\"}. Do not set ATTACHMENTS_TEMPLATE_NAME through props; this field owns it."
        },
        "lookup": {
          "$ref": "#/$defs/field/properties/lookup"
        },
        "options": {
          "$ref": "#/$defs/field/properties/options"
        },
        "required": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "props": {
          "type": "object",
          "description": "Raw cell properties, for presentation and behaviour the named fields above do not cover. Property names are the AnyDB cell-property constants, e.g. BACKGROUND_COLOR, TEXT_BOLD, TEXT_ALIGN, CELL_HIDDEN, FORM_HIDDEN, CELL_DISPLAY_AS, CELL_ERROR, DATE_DISPLAY, CHECKBOX_DISPLAY, X_SIZE. Do not set CELL_DESCRIPTION, HEADING_LABEL, CELL_LOCKED, CELL_REQUIRED, SELECT_OPTIONS, or ATTACHMENTS_TEMPLATE_NAME here - use the description, headingLabel, locked, required, options, and targetType fields instead; sending them here is rejected. AI_PROMPT is how an ai-format cell gets its prompt, and BUTTON_ACTION_TYPE/BUTTON_ACTION_VALUE wire a button-format cell to an automation. These cannot be set: SCRIPT_SOURCE, ATTACHMENTS_TEMPLATE_ID, ATTACHMENTS_PARENT, VALUE_OVERRIDE, CELL_HIDDEN_ACCESS, CELL_LOCKED_ACCESS. On update, sending props replaces the whole map for that field; omitting it preserves what is already there.",
          "additionalProperties": {
            "$ref": "#/$defs/cellProp"
          }
        }
      }
    },
    "updateTypeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamid",
        "adbid",
        "templateName",
        "clientRequestId",
        "expectedRevision",
        "changes",
        "confirmDataLoss"
      ],
      "properties": {
        "teamid": {
          "$ref": "#/$defs/objectId"
        },
        "adbid": {
          "$ref": "#/$defs/objectId"
        },
        "templateName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "clientRequestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expectedRevision": {
          "type": "string",
          "minLength": 1
        },
        "validateOnly": {
          "type": "boolean",
          "default": false
        },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string"
            },
            "icon": {
              "type": "string",
              "description": "Replacement Lucide icon and colors in the canonical format icon::<lucide-icon-name>::<foreground-hex>::<background-hex>. The background hex is not decorative metadata: it is painted as the type card's background in the workspace type list, in both the grid and hierarchy views, and the card border is derived from it, so it is how a type is color-coded or pastel-tinted. Use #FAFAFA as the background to leave the card neutral; that exact value is the no-tint sentinel and renders as a plain white card. This is unrelated to the per-field BACKGROUND_COLOR property, which tints a single cell inside a record and has no effect on the card."
            },
            "titleFormula": {
              "type": "string",
              "description": "Replacement record-title formula. Must be a formula expression in the same language as a cell formula, not a template string. CONCAT is the only supported way to join text: CONCAT('Meeting: ', {{Subject}}) works, while {{Subject}} ({{Status}}), {{A}} & {{B}} and {{A}} + {{B}} do not. A template string, an unknown field key, an unknown function, or a syntax error is rejected silently \u2014 the record keeps its existing name and no error is returned \u2014 so confirm a new formula by reading one record's meta.name back. Reference only field keys that exist on the type after this update is applied, and send an empty string to clear it."
            },
            "addFields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/field"
              }
            },
            "updateFields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fieldUpdate"
              }
            },
            "removeFields": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "replaceBadges": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/badge"
              }
            }
          }
        },
        "confirmDataLoss": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "getTypeMigrationStatusInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamid",
        "adbid",
        "jobId"
      ],
      "properties": {
        "teamid": {
          "$ref": "#/$defs/objectId"
        },
        "adbid": {
          "$ref": "#/$defs/objectId"
        },
        "jobId": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "workflowTriggerConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "templateName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "fieldNames": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parentRecordId": {
          "$ref": "#/$defs/objectId"
        },
        "filter": {
          "type": "string",
          "minLength": 1
        },
        "interval": {
          "type": "string",
          "minLength": 1
        },
        "specificTime": {
          "type": "string",
          "minLength": 1
        },
        "daysOfWeek": {
          "type": "string",
          "minLength": 1
        },
        "daysOfMonth": {
          "type": "string",
          "minLength": 1
        },
        "startTime": {
          "type": "string",
          "minLength": 1
        },
        "endTime": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workflowAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "config"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^(?!trigger$)[A-Za-z][A-Za-z0-9_-]{0,79}$",
          "description": "Client-local action key used by later symbolic bindings."
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Registered action type returned by anydb_list_workflow_actions."
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "config": {
          "type": "object",
          "description": "Action input matching its catalog inputSchema. Use {{trigger.outputName}} or {{priorActionKey.outputName}} for artifact output bindings. For action_script, config.script holds the executable JavaScript body and config.timeoutMs its optional timeout; anydb_get_workflow returns the stored source at the same path for review."
        }
      }
    },
    "createWorkflowInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamid",
        "adbid",
        "clientRequestId",
        "workflow"
      ],
      "properties": {
        "teamid": {
          "$ref": "#/$defs/objectId"
        },
        "adbid": {
          "$ref": "#/$defs/objectId"
        },
        "clientRequestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "validateOnly": {
          "type": "boolean",
          "default": false
        },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "trigger"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "trigger": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "config"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "trigger_on_form_submit",
                    "trigger_on_record_create",
                    "trigger_on_record_update",
                    "trigger_on_schedule",
                    "trigger_manual"
                  ]
                },
                "config": {
                  "$ref": "#/$defs/workflowTriggerConfig"
                }
              }
            },
            "script": {
              "type": "object",
              "additionalProperties": false,
              "description": "Single-action-script shorthand accepted only at creation. anydb_update_workflow does not accept it; send changes.actions with an action_script entry instead.",
              "required": [
                "source"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Executable JavaScript body for the workflow script runtime, validated before persistence. No async IIFE wrapper, no import/export/require/eval/Function/process/globalThis, only documented anydb.* and output.* members accessed by literal name, awaited data and mutation calls, and an await such as anydb.yield() in every loop body. See the Script Actions rules in anydb://guides/solution-building/v1 and the action_script guidance from anydb_list_workflow_actions.",
                  "$comment": "Authoritative runtime surface: script.runtime.ts, surfaced through the action_script catalog entry."
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 30000,
                  "description": "Script execution timeout in milliseconds, clamped by the server to its configured cap (30000 by default). Design each run to finish inside this budget by filtering or paging instead of scanning a whole type."
                }
              }
            },
            "actions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/workflowAction"
              }
            }
          },
          "oneOf": [
            {
              "required": [
                "actions"
              ],
              "not": {
                "required": [
                  "script"
                ]
              }
            },
            {
              "required": [
                "script"
              ],
              "not": {
                "required": [
                  "actions"
                ]
              }
            }
          ]
        }
      }
    },
    "updateWorkflowInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamid",
        "adbid",
        "workflowId",
        "clientRequestId",
        "changes"
      ],
      "properties": {
        "teamid": {
          "$ref": "#/$defs/objectId"
        },
        "adbid": {
          "$ref": "#/$defs/objectId"
        },
        "workflowId": {
          "$ref": "#/$defs/objectId"
        },
        "clientRequestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "enabled": {
              "type": "boolean"
            },
            "actions": {
              "type": "array",
              "minItems": 1,
              "description": "Complete ordered replacement action chain. Omit to preserve existing actions; include the desired final chain to add, update, remove, or reorder actions.",
              "items": {
                "$ref": "#/$defs/workflowAction"
              }
            }
          }
        }
      }
    },
    "executeWorkflowInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "teamid",
        "adbid",
        "workflowId",
        "simulate"
      ],
      "properties": {
        "teamid": {
          "$ref": "#/$defs/objectId"
        },
        "adbid": {
          "$ref": "#/$defs/objectId"
        },
        "workflowId": {
          "$ref": "#/$defs/objectId"
        },
        "adoid": {
          "$ref": "#/$defs/objectId",
          "description": "Optional record context for record-based workflow triggers."
        },
        "simulate": {
          "type": "boolean",
          "description": "Use true for dry-run simulation and false for normal execution with side effects."
        }
      }
    },
    "cellProp": {
      "type": "object",
      "additionalProperties": false,
      "description": "One cell property. Supply value, expr, or both. expr is an AnyDB formula evaluated per record, which is how conditional formatting and visibility are expressed; value is the static fallback shown until it first evaluates. Inside a property expression CURRCELL is this cell's own value.",
      "properties": {
        "value": {
          "description": "Static value, e.g. \"#FF0000\" for BACKGROUND_COLOR or true for TEXT_BOLD."
        },
        "expr": {
          "type": "string",
          "minLength": 1,
          "description": "AnyDB formula, e.g. IF({{Status}}==\"High\", \"#FF0000\", \"#00FF00\"). Reference other fields as {{Field Key}} and this cell as CURRCELL."
        }
      },
      "minProperties": 1
    }
  },
