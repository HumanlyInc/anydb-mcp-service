{
  "name": "anydb-mcp-service",
  "version": "2.2.0",
  "description": "Model Context Protocol (MCP) server for AnyDB database and record management through AI assistants",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "anydb-mcp-service": "dist/index.js"
  },
  "files": [
    "dist",
    "resources",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HumanlyInc/anydb-mcp-service.git"
  },
  "homepage": "https://www.anydb.com/support/integrations/mcp-claude",
  "bugs": {
    "url": "https://www.anydb.com/support"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "start": "npm run build && node dist/index.js",
    "start:mcp": "npm run build && node dist/index.js",
    "start:http": "npm run build && node dist/http.js",
    "start:rest": "npm run build && node dist/rest-server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "anydb",
    "database",
    "ai",
    "claude",
    "chatgpt",
    "automation",
    "records",
    "workflow",
    "integration"
  ],
  "author": "AnyDB Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "jose": "^6.2.10",
    "mime-types": "^3.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.10.5",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.7.2"
  }
}
